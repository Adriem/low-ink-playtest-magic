// Cloudflare Workers, which serves the built app as static assets: no Worker script.
// Workers Builds deploys main (npx wrangler deploy) and every other branch as a Preview (npx wrangler preview).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "low-ink-playtest-magic",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    // Paths that don't exist get the 404 page (public/404.html), with a 404 status
    "not_found_handling": "404-page",
  },
  // Lets npx wrangler preview deploy branches as Previews, with the settings above
  "previews": {},
}
